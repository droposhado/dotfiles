#!/usr/bin/env bash

set -e

chsh -s /bin/bash

brew doctor
brew update
brew bundle --verbose --file=/dev/stdin <<EOF

{{ range .packages.brew.taps }}
tap {{ . }}
{{ end }}

cask_args appdir: "{{ .packages.brew.cask_args.appdir }}", require_sha: {{ .packages.brew.cask_args.require_sha }}

{{ range .packages.brew.packages }}
brew {{ . }}
{{ end }}

{{ range .packages.brew.casks }}
cask {{ . }}
{{ end }}
EOF

brew cleanup
